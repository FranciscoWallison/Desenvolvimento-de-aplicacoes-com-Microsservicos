# Copie para .env apenas se for rodar os scripts à mão.
# No Claude Code, estes valores vão no bloco "env" do .claude.json (ver README).

# ── Navegador ─────────────────────────────────────────────────────────────────
MCP_NAV_BROWSER_CHANNEL=chrome
MCP_NAV_USER_DATA_DIR=C:/Users/walli/.mcp-navegador/chrome-profile
MCP_NAV_HEADLESS=0
MCP_NAV_VIEWPORT=1440x900

# Fallback se o Chrome instalado der problema (Chrome for Testing já em disco):
# MCP_NAV_EXECUTABLE_PATH=C:/Users/walli/AppData/Local/ms-playwright/chromium-1223/chrome-win64/chrome.exe

# Modo anexar — só se o MFA por passkey/Windows Hello falhar.
# Suba o Chrome com --remote-debugging-port=9222 e um user-data-dir NÃO-padrão.
# MCP_NAV_CDP_ENDPOINT=http://127.0.0.1:9222

# ── Saída da documentação ─────────────────────────────────────────────────────
MCP_NAV_DOCS_ROOT=f:/projetos/Desenvolvimento-de-aplicacoes-com-Microsservicos
MCP_NAV_DEFAULT_DOCS_DIR=Devops/Cloud/Azure-Academy
MCP_NAV_IMG_SUBDIR=imgs

# ── Segurança ─────────────────────────────────────────────────────────────────
MCP_NAV_ALLOW_EVAL=0
MCP_NAV_CONFIRM_CHANNEL=browser
MCP_NAV_CONFIRM_TTL_SEC=120
MCP_NAV_MAX_WAIT_SEC=60

# ── Log ───────────────────────────────────────────────────────────────────────
MCP_NAV_LOG_LEVEL=info
MCP_NAV_LOG_FILE=f:/projetos/Desenvolvimento-de-aplicacoes-com-Microsservicos/tools/mcp-navegador/state/logs/navegador.log

# ── Playwright ────────────────────────────────────────────────────────────────
PLAYWRIGHT_BROWSERS_PATH=C:/Users/walli/AppData/Local/ms-playwright
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
